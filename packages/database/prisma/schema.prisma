generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  member
}

enum OAuthProviderType {
  google
  microsoft
  facebook
}

model Organization {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  oauthProviders OAuthProvider[]
  refreshTokens  RefreshToken[]
  journalEntries JournalEntry[]
  aiConnections  AiConnection[]
  investorProfiles InvestorProfile[]

  @@map("organizations")
}

model User {
  id           String          @id @default(cuid())
  organizationId String
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email        String
  displayName  String
  role         UserRole
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  oauthProviders OAuthProvider[]
  refreshTokens  RefreshToken[]
  journalEntries JournalEntry[]
  investorProfiles InvestorProfile[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model OAuthProvider {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProviderType
  providerUserId String
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@unique([organizationId, provider, providerUserId])
  @@unique([organizationId, userId, provider])
  @@index([userId])
  @@map("oauth_providers")
}

model RefreshToken {
  id         String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  localDate      DateTime @db.Date
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, localDate])
  @@index([organizationId])
  @@index([userId])
  @@index([localDate])
  @@index([organizationId, userId, localDate])
  @@map("journal_entries")
}

model AiConnection {
  id                     String      @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  providerId             String
  label                 String
  enabled               Boolean     @default(true)
  secretPayload         Json
  configPayload         Json
  lastTestedAt          DateTime?
  lastTestStatus        String?
  lastTestFailureKind   String?
  lastTestErrorSummary  String?
  consecutiveFailureCount Int        @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([organizationId, label])
  @@index([organizationId])
  @@map("ai_connections")
}

model InvestorProfile {
  id                        String       @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId                    String
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredName             String?
  experienceLevel           String?
  portfolioContext          Json?
  primaryObjective          String?
  strategyPresets           Json?
  customStrategyDescription String?
  freeformAiContext         String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("investor_profiles")
}

model HelpRuntimeCache {
  id                    String   @id @default(cuid())
  channelId             String   @unique
  indexPayload          Json?
  contentPayload        Json?
  effectiveAppVersion   String?
  contentVersion        String?
  schemaVersion         Int?
  freshnessStatus       String   @default("unavailable")
  lastRefreshStatus     String   @default("never_attempted")
  fetchedAt             DateTime?
  lastDownloadAttemptAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("help_runtime_caches")
}
