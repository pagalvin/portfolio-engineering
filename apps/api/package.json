{
  "name": "@portfolio-engineering/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "corepack pnpm --filter @portfolio-engineering/validation build",
    "prebuild": "corepack pnpm --filter @portfolio-engineering/validation build",
    "pretypecheck": "corepack pnpm --filter @portfolio-engineering/validation build",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint .",
    "test": "corepack pnpm build && node --test dist/plugins/ai.test.js dist/plugins/journalAnalysis.test.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@portfolio-engineering/ai": "workspace:*",
    "@portfolio-engineering/auth": "workspace:*",
    "@portfolio-engineering/database": "workspace:*",
    "@portfolio-engineering/shared-types": "workspace:*",
    "@portfolio-engineering/validation": "workspace:*",
    "fastify": "^5.10.0",
    "jose": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2"
  }
}
